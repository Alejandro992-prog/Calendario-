# ============================================================
# Garde Electrodomésticos — Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).

# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# --- OpenAI Vision (para OCR de capturas de pantalla) ---
# Opcional: si no se configura, el OCR de capturas estará deshabilitado.
VITE_OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
